# Application
APP_NAME="AI Stock Research Platform"
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql+asyncpg://stockuser:stockpass@localhost:5432/stockdb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Market Hours (IST = UTC+5:30)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30
MARKET_TIMEZONE=Asia/Kolkata

# Data
DEFAULT_EXCHANGE_SUFFIX=.NS
DATA_BACKFILL_DAYS=730

# Paper Trading
DEFAULT_COMMISSION=20.0
DEFAULT_SLIPPAGE_PCT=0.001

# AI
MODEL_VERSION=rule_based_v1
SHAP_MAX_FEATURES=10

# Cache TTLs (seconds)
CACHE_TTL_QUOTE=60
CACHE_TTL_DAILY_CANDLES=3600
CACHE_TTL_INTRADAY=60

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
