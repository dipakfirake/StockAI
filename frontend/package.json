{
  "name": "ai-stock-research-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "AI Stock Research Platform — India-first, open-source, explainable AI investment research",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
